{
  "name": "gymcore",
  "version": "1.0.0",
  "description": "Sistema de gestión integral para gimnasios con arquitectura de microservicios",
  "main": "index.js",
  "scripts": {
    "sync:users": "pnpm exec ts-node backend/apps/auth-service/src/resync-users.ts",
    "clean:dist": "pnpm -r exec powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "dev": "pnpm --parallel --stream -r run start:dev",
    "rebuild": "pnpm clean:dist && pnpm build",
    
    "dev:all": "concurrently \"pnpm dev:gateway\" \"pnpm dev:auth\" \"pnpm dev:gyms\" \"pnpm dev:inventory\" \"pnpm dev:notifications\" \"pnpm dev:payments\" \"pnpm dev:analytics\" \"pnpm dev:biometric\"",
    "dev:backend": "concurrently \"pnpm dev:gateway\" \"pnpm dev:auth\" \"pnpm dev:gyms\" \"pnpm dev:inventory\" \"pnpm dev:notifications\" \"pnpm dev:payments\" \"pnpm dev:analytics\" \"pnpm dev:biometric\"",
    
    "dev:gateway": "pnpm --filter api-gateway run start:dev",
    "dev:auth": "pnpm --filter auth-service run start:dev",
    "dev:gyms": "pnpm --filter gym-management-service run start:dev",
    "dev:payments": "pnpm --filter payment-service run start:dev",
    "dev:notifications": "pnpm --filter notification-service run start:dev",
    "dev:inventory": "pnpm --filter inventory-service run start:dev",
    "dev:analytics": "pnpm --filter analytics-service run start:dev",
    "dev:biometric": "pnpm --filter biometric-service run start:dev",
    "dev:logging": "pnpm --filter logging-service run start:dev",
    "dev:frontend": "pnpm --filter web-dashboard run dev",
    
    "build": "pnpm -r run build",
    "build:backend": "pnpm --filter \"./backend/apps/*\" run build",
    "build:frontend": "pnpm --filter web-dashboard run build",
    "build:gateway": "pnpm --filter api-gateway run build",
    "build:auth": "pnpm --filter auth-service run build",
    "build:gyms": "pnpm --filter gym-management-service run build",
    "build:payments": "pnpm --filter payment-service run build",
    "build:analytics": "pnpm --filter analytics-service run build",
    
    "start": "pnpm --parallel --stream -r run start:prod",
    "start:gateway": "pnpm --filter api-gateway run start:prod",
    "start:auth": "pnpm --filter auth-service run start:prod",
    "start:gyms": "pnpm --filter gym-management-service run start:prod",
    "start:payments": "pnpm --filter payment-service run start:prod",
    "start:analytics": "pnpm --filter analytics-service run start:prod",
    
    "db:generate:auth": "pnpm exec prisma generate --schema=./backend/apps/auth-service/prisma/schema.prisma",
    "db:generate:gym": "pnpm exec prisma generate --schema=./backend/apps/gym-management-service/prisma/schema.prisma",
    "db:generate:inventory": "pnpm exec prisma generate --schema=./backend/apps/inventory-service/prisma/schema.prisma",
    "db:generate:payment": "pnpm exec prisma generate --schema=./backend/apps/payment-service/prisma/schema.prisma",
    "db:generate:analytics": "pnpm exec prisma generate --schema=./backend/apps/analytics-service/prisma/schema.prisma",
    "db:generate:all": "pnpm -r --parallel run db:generate",
    
    "db:migrate:auth": "pnpm exec prisma migrate dev --schema=./backend/apps/auth-service/prisma/schema.prisma",
    "db:migrate:gym": "pnpm exec prisma migrate dev --schema=./backend/apps/gym-management-service/prisma/schema.prisma",
    "db:migrate:inventory": "pnpm exec prisma migrate dev --schema=./backend/apps/inventory-service/prisma/schema.prisma",
    "db:migrate:payment": "pnpm exec prisma migrate dev --schema=./backend/apps/payment-service/prisma/schema.prisma",
    "db:migrate:analytics": "pnpm exec prisma migrate dev --schema=./backend/apps/analytics-service/prisma/schema.prisma",
    "db:migrate:all": "pnpm db:migrate:auth && pnpm db:migrate:gym && pnpm db:migrate:inventory && pnpm db:migrate:payment && pnpm db:migrate:analytics",
    
    "db:push:auth": "pnpm exec prisma db push --schema=./backend/apps/auth-service/prisma/schema.prisma",
    "db:push:gym": "pnpm exec prisma db push --schema=./backend/apps/gym-management-service/prisma/schema.prisma",
    "db:push:inventory": "pnpm exec prisma db push --schema=./backend/apps/inventory-service/prisma/schema.prisma",
    "db:push:payment": "pnpm exec prisma db push --schema=./backend/apps/payment-service/prisma/schema.prisma",
    "db:push:analytics": "pnpm exec prisma db push --schema=./backend/apps/analytics-service/prisma/schema.prisma",
    
    "db:reset:auth": "pnpm exec prisma migrate reset --schema=./backend/apps/auth-service/prisma/schema.prisma",
    "db:reset:gym": "pnpm exec prisma migrate reset --schema=./backend/apps/gym-management-service/prisma/schema.prisma",
    "db:reset:inventory": "pnpm exec prisma migrate reset --schema=./backend/apps/inventory-service/prisma/schema.prisma",
    "db:reset:payment": "pnpm exec prisma migrate reset --schema=./backend/apps/payment-service/prisma/schema.prisma",
    "db:reset:analytics": "pnpm exec prisma migrate reset --schema=./backend/apps/analytics-service/prisma/schema.prisma",
    "db:reset:all": "pnpm db:reset:auth && pnpm db:reset:gym && pnpm db:reset:inventory && pnpm db:reset:payment && pnpm db:reset:analytics",
    
    "reset:complete": "node scripts/reset-complete.js",
    "test": "pnpm -r run test",
    "test:auth": "pnpm --filter auth-service run test",
    "test:gyms": "pnpm --filter gym-management-service run test",
    "test:payments": "pnpm --filter payment-service run test",
    "test:gateway": "pnpm --filter api-gateway run test",
    "test:inventory": "pnpm --filter inventory-service run test",
    "test:analytics": "pnpm --filter analytics-service run test",
    "test:notifications": "pnpm --filter notification-service run test",
    "test:frontend": "pnpm --filter web-dashboard run test",
    "test:coverage": "pnpm test:cov && node scripts/merge-coverage.js",
    "test:watch": "pnpm -r run test:watch",
    "test:e2e": "pnpm -r run test:e2e",
    "test:unit:backend": "concurrently \"pnpm test:auth\" \"pnpm test:gyms\" \"pnpm test:payments\" \"pnpm test:gateway\" \"pnpm test:inventory\" \"pnpm test:analytics\" \"pnpm test:notifications\"",
    "test:unit:all": "concurrently \"pnpm test:unit:backend\" \"pnpm test:frontend\"",
    "test:sonar": "pnpm test:cov && node scripts/merge-coverage.js",
    "test:cov": "pnpm -r run test:cov",
    
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false pnpm -r run lint",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false pnpm -r run lint --fix",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "install:all": "pnpm install && pnpm -r install",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "reinstall": "pnpm clean:deps && pnpm install:all",
    
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    
    "health": "node scripts/health-check.js",
    "check:services": "concurrently \"curl -f http://localhost:3000/health\" \"curl -f http://localhost:3030\" \"curl -f http://localhost:9200/_cluster/health\" \"curl -f http://localhost:5601/api/status\"",
    "dev:services": "pnpm dev:backend",
    "dev:full": "pnpm dev:all",
    "postinstall": "pnpm db:generate:all",
    "precommit": "pnpm lint && pnpm test",
    "prepare": "husky install || true",
    
    "db:init:owner": "pnpm exec ts-node backend/apps/auth-service/src/inicializar-owner.ts"
  },
  "keywords": [
    "gym",
    "fitness",
    "management",
    "microservices",
    "nestjs",
    "react",
    "typescript",
    "supabase"
  ],
  "author": "Tu Nombre",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "@prisma/client": "^6.9.0"
    }
  },
  "eslintConfig": {
    "env": {
      "es6": true
    }
  }
}