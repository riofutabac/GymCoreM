# API Gateway Environment Variables

# Basic Configuration
PORT=3000
NODE_ENV=development

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
GYM_SERVICE_URL=http://gym-management-service:3002
PAYMENT_SERVICE_URL=http://payment-service:3003
INVENTORY_SERVICE_URL=http://inventory-service:3004
ANALYTICS_SERVICE_URL=http://analytics-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006
BIOMETRIC_SERVICE_URL=http://biometric-service:3007
LOGGING_SERVICE_URL=http://logging-service:3008

# Message Bus
MESSAGE_BUS_URL=amqp://guest:guest@rabbitmq:5672

# Redis
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3030