# ============================================================================
# CONFIGURACIÓN ELASTICSEARCH Y KIBANA
# ============================================================================
# Cuando tu amigo configure Elasticsearch, usar estas variables:

# URL del cluster de Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Si Elasticsearch requiere autenticación
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ============================================================================
# RABBITMQ CONFIGURATION
# ============================================================================
MESSAGE_BUS_URL=amqp://localhost:5672

# ============================================================================
# LOGGING SERVICE CONFIGURATION
# ============================================================================
LOGGING_SERVICE_PORT=3009

# ============================================================================
# NOTAS PARA TU AMIGO:
# ============================================================================
# 1. Elasticsearch: docker run -d --name elasticsearch -p 9200:9200 -e "discovery.type=single-node" -e "xpack.security.enabled=false" docker.elastic.co/elasticsearch/elasticsearch:8.15.0
# 2. Kibana: docker run -d --name kibana -p 5601:5601 -e "ELASTICSEARCH_HOSTS=http://localhost:9200" docker.elastic.co/kibana/kibana:8.15.0
# 3. Acceder a Kibana: http://localhost:5601
# 4. Los logs se almacenarán en el índice 'gymcore-logs'
