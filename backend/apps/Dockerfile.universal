# Ubicación: riofutabac-gymcorem/backend/apps/Dockerfile.universal
# Propósito: Construir una imagen optimizada y auto-contenida para un microservicio.

# --- ETAPA 1: Builder ---
# Esta etapa instala dependencias, compila el código y genera el cliente de Prisma.
FROM node:18-alpine AS builder

# Argumentos pasados desde docker-compose.prod.yml
ARG SERVICE_NAME
ARG INFISICAL_TOKEN
ARG INFISICAL_ENV=prod
ARG INFISICAL_PATH=/

WORKDIR /app

# Instala herramientas globales
RUN npm install -g pnpm @infisical/cli

# Copia los manifiestos de paquetes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .infisical.json ./
# Copia el package.json específico del servicio para una mejor gestión del caché
COPY backend/apps/${SERVICE_NAME}/package.json ./backend/apps/${SERVICE_NAME}/

# Instala dependencias de producción
RUN pnpm install --prod --frozen-lockfile

# Copia todo el código fuente
COPY . .

# Valida que el INFISICAL_TOKEN fue pasado correctamente
RUN if [ -z "$INFISICAL_TOKEN" ]; then echo "ERROR: INFISICAL_TOKEN es requerido en tiempo de build" >&2; exit 1; fi

# Genera el cliente de Prisma si el servicio lo necesita
RUN if [ -f "backend/apps/${SERVICE_NAME}/prisma/schema.prisma" ]; then \
        echo "Generando cliente de Prisma para ${SERVICE_NAME}..."; \
        infisical run --token=$INFISICAL_TOKEN --env=$INFISICAL_ENV --path=$INFISICAL_PATH \
        -- pnpm --filter=${SERVICE_NAME} exec prisma generate; \
    fi

# Compila el servicio específico
RUN echo "Compilando ${SERVICE_NAME}..." && \
    infisical run --token=$INFISICAL_TOKEN --env=$INFISICAL_ENV --path=$INFISICAL_PATH \
    -- pnpm --filter=${SERVICE_NAME} run build

# --- ETAPA 2: Runner ---
# Esta etapa crea la imagen final, más pequeña y optimizada.
FROM node:18-alpine

WORKDIR /app

ARG SERVICE_NAME
ARG PORT=3000

ENV NODE_ENV=production

# Instala solo las herramientas necesarias para correr
RUN npm install -g pnpm @infisical/cli

# Copia solo los artefactos necesarios desde la etapa 'builder'
COPY package.json pnpm-workspace.yaml .infisical.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend/apps/${SERVICE_NAME}/dist ./backend/apps/${SERVICE_NAME}/dist
# Copia el cliente de Prisma generado si existe
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma 2>/dev/null || true

EXPOSE ${PORT}

# El comando de inicio. 'infisical run' usará las variables de entorno
# (INFISICAL_TOKEN, etc.) que se le pasan desde docker-compose en runtime.
CMD ["sh", "-c", "infisical run -- pnpm --filter=${SERVICE_NAME} run start:prod"]

---
# Ubicación: riofutabac-gymcorem/frontend/web-dashboard/Dockerfile
# Propósito: Construir una imagen optimizada para el frontend de Next.js.

# --- ETAPA 1: Dependencias ---
FROM node:18-alpine AS deps
WORKDIR /app
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/web-dashboard/package.json ./frontend/web-dashboard/
RUN pnpm install --frozen-lockfile

# --- ETAPA 2: Builder ---
FROM node:18-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED 1
# Construye solo el workspace del frontend
RUN pnpm --filter web-dashboard run build

# --- ETAPA 3: Runner ---
FROM node:18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED 1

# Copia la salida del build optimizado (standalone)
COPY --from=builder /app/frontend/web-dashboard/.next/standalone ./
# Copia las carpetas de assets estáticos y públicos
COPY --from=builder /app/frontend/web-dashboard/public ./frontend/web-dashboard/public
COPY --from=builder /app/frontend/web-dashboard/.next/static ./frontend/web-dashboard/.next/static

EXPOSE 3030

# El comando para iniciar el servidor de Next.js optimizado
CMD ["node", "frontend/web-dashboard/server.js"]
