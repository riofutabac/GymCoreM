# .dockerignore

# Ignorar dependencias, ya que se instalan dentro del contenedor
node_modules
**/node_modules

# Ignorar artefactos de construcción
dist
**/dist
.next

# Ignorar logs y archivos del sistema
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignorar carpetas de configuración de IDEs
.idea
.vscode

# Ignorar archivos del sistema operativo
.DS_Store
Thumbs.db

# Ignorar la carpeta de Git
.git